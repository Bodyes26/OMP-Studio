    "marked": "^18.0.10",
    "mermaid": "^11.17.0",
    "dompurify": "^3.4.17",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "monaco-editor": "^0.56.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@inlang/paraglide-js": "^2.25.1",
