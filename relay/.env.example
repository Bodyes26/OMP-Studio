# Random secret, at least 32 characters. Generate it with: openssl rand -hex 32
# It pairs your first device and opens the /diag page: keep it private.
RELAY_ADMIN_TOKEN=

# Docker network your reverse proxy container is attached to (see: docker network ls).
PROXY_NETWORK=

# R-MI-56: address of your iroh relay (https://iroh-relay.example.com).
# Studio reads it from GET /v1/host/info, so one address (this server) is
# enough for both phones and computers. Leave it empty if you do not have an
# iroh relay: Studio will ask for it under "Advanced".
RELAY_IROH_RELAY_URL=
