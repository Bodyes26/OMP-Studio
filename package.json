{
  "name": "omp-studio-app",
  "version": "1.9.0",
  "description": "Guscio desktop multi-progetto per l'agente omp: terminale integrato, albero dei file, editor e pannello consumi.",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "compile:i18n": "node node_modules/@inlang/paraglide-js/bin/run.js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations --disable-async-local-storage",
    "check": "node node_modules/@inlang/paraglide-js/bin/run.js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations --disable-async-local-storage && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:icons": "node scripts/check-icons.mjs",
    "check:commands": "node --no-warnings --experimental-strip-types scripts/check-commands.mjs",
    "logo": "node scripts/generate-logo.mjs",
    "tauri": "tauri",
    "tauri:cdp": "set \"WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=--remote-debugging-port=9222\" && tauri dev",
    "test": "node scripts/run-smoke-tests.mjs",
    "test:smoke": "node scripts/run-smoke-tests.mjs",
    "release": "node scripts/release.mjs",
    "nightly": "node scripts/publish-nightly.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.34.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "~2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "esbuild-wasm": "0.28.2",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.10",
    "mermaid": "^11.17.0",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.1",
    "@inlang/plugin-message-format": "^4.4.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "@types/lodash-es": "^4.17.12",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "cookie": "^2.0.1",
    "nanoid": "^3.3.18",
    "devalue": "^5.9.4",
    "katex": "^0.18.2",
    "source-map-js": "^1.2.2"
  }
}
