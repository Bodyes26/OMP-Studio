<script>
	// Sopra la foto il testo va in difference; dopo l'apertura passa su un fondo pieno,
	// cosi' non si sovrappone ai testi delle sezioni che scorrono sotto.
	const header = document.querySelector('header');
	const gate = document.getElementById('gate');
	if (header) {
		const update = () => header.classList.toggle('solid', !gate || gate.getBoundingClientRect().bottom < 80);
		addEventListener('scroll', update, { passive: true });
		update();
	}
</script>
