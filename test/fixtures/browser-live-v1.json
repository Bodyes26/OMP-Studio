{
	"contract": "browser-live-v1",
	"revision": "2026-09-03",
	"description": "Shared compatibility fixture for the browser-live-v1 contract. Byte-identical copies live in omp-studio-app (test/fixtures) and in the OMP runtime (packages/coding-agent/test/fixtures). Both test suites drive their own implementation against these cases; any drift between the two copies is a contract break.",
	"capability": {
		"name": "browser-live",
		"version": 1,
		"transports": ["local-websocket"],
		"features": ["binary-frames", "control-epochs", "private-takeover", "inspector", "chrome-relay"]
	},
	"fallback": {
		"toolEvents": ["tool_execution_start", "tool_execution_update", "tool_execution_end"],
		"toolName": "browser",
		"screenshotDetailsKey": "screenshots",
		"note": "When browser-live is not negotiated the host renders the browser tool exactly as before: lifecycle from the three tool_execution events, images from result.details.screenshots and from image content blocks."
	},
	"eventTypes": ["browser_live_tab_state", "browser_live_closed"],
	"closeReasons": ["closed", "session-ended", "runtime-shutdown", "revoked", "failed"],
	"errorCodes": [
